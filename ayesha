<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <style>
        /* CSS Variables & Reset */
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --border-color: #30363d;
            --text-main: #c9d1d9;
            --text-heading: #f0f6fc;
            --accent: #58a6ff;
            --accent-hover: #1f6feb;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        /* Header / Hero Section */
        header {
            text-align: center;
            padding: 3rem 1.5rem;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            margin-bottom: 2rem;
        }

        header h1 {
            color: var(--text-heading);
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        header p {
            color: var(--accent);
            font-size: 1.2rem;
            font-weight: 500;
        }

        /* Card Section Styling */
        section {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        h2 {
            color: var(--text-heading);
            font-size: 1.5rem;
            margin-bottom: 1rem;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 0.5rem;
        }

        /* Skills Badge Grid */
        .skills-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .skill-badge {
            background-color: rgba(88, 166, 255, 0.1);
            color: var(--accent);
            border: 1px solid rgba(88, 166, 255, 0.3);
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Projects Grid */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 1rem;
        }

        .project-card {
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.5rem;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .project-card:hover {
            transform: translateY(-3px);
            border-color: var(--accent);
        }

        .project-card h3 {
            color: var(--text-heading);
            margin-bottom: 0.5rem;
        }

        .project-card p {
            font-size: 0.95rem;
            margin-bottom: 1rem;
        }

        .project-link {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .project-link:hover {
            text-decoration: underline;
        }

        /* Contact Section */
        .contact-links {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .btn {
            display: inline-block;
            background-color: var(--accent);
            color: #ffffff;
            padding: 0.6rem 1.2rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

        .btn:hover {
            background-color: var(--accent-hover);
        }

        /* Footer */
        footer {
            text-align: center;
            color: #8b949e;
            font-size: 0.85rem;
            margin-top: 2rem;
        }

        /* Mobile Optimization */
        @media (max-width: 600px) {
            header h1 {
                font-size: 1.8rem;
            }
            body {
                padding: 1rem 0.5rem;
            }
            section {
                padding: 1.25rem;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Header / Hero -->
        <header>
            <h1>Ume Zar Ayesha</h1>
            <p>Web Developer</p>
        </header>

        <!-- About Me Section -->
        <section id="about">
            <h2>About Me</h2>
            <p>
                Hello! I am a passionate developer currently building responsive web applications and exploring modern technologies. Welcome to my personal portfolio repository page!
            </p>
        </section>

        <!-- Skills Section -->
        <section id="skills">
            <h2>Technologies & Skills</h2>
            <div class="skills-grid">
                <span class="skill-badge">HTML5</span>
                <span class="skill-badge">CSS3</span>
                <span class="skill-badge">JavaScript</span>
                <span class="skill-badge">Git & GitHub</span>
                <span class="skill-badge">Python</span>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects">
            <h2>Featured Projects</h2>
            <div class="projects-grid">
                <div class="project-card">
                    <h3>Project One</h3>
                    <p>A brief description of your first project highlighting the tools and languages used.</p>
                    <a href="#" class="project-link">View Repository &rarr;</a>
                </div>
                <div class="project-card">
                    <h3>Project Two</h3>
                    <p>A brief description of your second project highlighting the key features and purpose.</p>
                    <a href="#" class="project-link">View Repository &rarr;</a>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact">
            <h2>Connect With Me</h2>
            <p>Feel free to reach out or check out my work on GitHub.</p>
            <div class="contact-links">
                <a href="https://github.com" target="_blank" class="btn">Umezar-Ayesha</a>
                <a href="mailto:zarayesha67@gmail.com" class="btn" style="background-color: transparent; border: 1px solid var(--border-color); color: var(--text-heading);">Send Email</a>
            </div>
        </section>

        <!-- Footer -->
        <footer>
            <p>Umezar-Ayesha Portfolio Assignment.</p>
        </footer>
    </div>

</body>
</html>
